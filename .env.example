# Server
PORT=3000

# SQLite DB path (on Railway, mount a volume at /data and set DB_PATH=/data/hisab.db)
DB_PATH=./data/hisab.db

# Bootstrap admin (created on first boot if users table is empty)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Session signing secret (set a long random string in prod)
SESSION_SECRET=change-me-in-prod

# Optional: Google Sheets sync. Either inline JSON or a file path.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_SPREADSHEET_ID=
